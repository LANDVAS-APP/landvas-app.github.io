<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- push notifications (APNs). "development" for builds run from Xcode; the Native apps workflow signs store and
	     TestFlight builds with "production" (see .github/workflows/native.yml, "Push entitlement"). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
