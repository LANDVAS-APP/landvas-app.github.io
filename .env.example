# ---- Backend -------------------------------------------------------------
# local     : everything runs in the browser (PGlite + IndexedDB). No accounts needed.
# supabase  : production multiplayer backend (requires the values below)
VITE_BACKEND=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public URL of the LANDVAS worker (minigame validation API), e.g. https://worker.landvas.app
VITE_WORKER_URL=

# ---- Map -----------------------------------------------------------------
# Optional vector basemap style (MapLibre style JSON URL). Empty = built-in offline world map.
# Examples: https://tiles.openfreemap.org/styles/liberty  (attribution required)
VITE_MAP_STYLE_URL=

# ---- App -----------------------------------------------------------------
VITE_ROUTER=browser          # browser | hash | memory
VITE_DEFAULT_THEME=dark      # dark | light | system
VITE_FONTS=self              # self (bundled, offline) | google
VITE_SW=on                   # PWA service worker
VITE_SUPPORT_EMAIL=support@example.com
