// Cloudflare Workers Builds config for landvas.app (worker: landvas-app-github-io).
// On the `source` branch Cloudflare builds the app and serves it as static assets;
// the `main` branch carries its own copy of this file (written by the deploy workflow).
{
  "name": "landvas-app-github-io",
  "compatibility_date": "2025-09-01",
  "build": { "command": "bash deploy/cloudflare-build.sh" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
