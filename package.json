{
  "name": "landvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LANDVAS — Own a piece. Paint the world. Multiplayer map-based art and territory game.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
