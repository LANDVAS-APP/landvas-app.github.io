{
  "name": "landvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LANDVAS — Own a piece. Play it your way. A multiplayer world-map game for every playstyle.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:sql": "vitest run tests/sql",
    "test:unit": "vitest run tests/unit",
    "worker": "tsx worker/main.ts",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "npm run build:artifact && node tests/e2e/core-loop.mjs",
    "build:artifact": "vite build --mode artifact",
    "build:native": "vite build --mode native --outDir dist-native",
    "native:sync": "npm run build:native && npx cap sync"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
